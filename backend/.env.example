DEBUG=True
DJANGO_SECRET_KEY=phase0-dev-only-change-me
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Leave empty to use SQLite. Example Postgres:
# DATABASE_URL=postgres://pulsif:pulsif@127.0.0.1:5432/pulsif
DATABASE_URL=
# Stripe test keys. Leave empty to pay with mock card 4242 4242 4242 4242.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Railway production (set these in the Railway dashboard, not here):
# DEBUG=False
# DJANGO_SECRET_KEY=generate-a-long-random-string
# ALLOWED_HOSTS=.up.railway.app
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://YOUR-FRONTEND.up.railway.app
# CSRF_TRUSTED_ORIGINS=https://pulsif-production.up.railway.app
# SERVE_MEDIA=True
# PUBLIC_SITE_URL=http://127.0.0.1:5173

# Cloudflare R2 (object storage — images survive redeploys):
# CF_R2_BUCKET_NAME=pulsif-media
# CF_R2_ENDPOINT_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# CF_R2_ACCESS_KEY_ID=<R2_ACCESS_KEY>
# CF_R2_SECRET_ACCESS_KEY=<R2_SECRET_KEY>
# CF_R2_CUSTOM_DOMAIN=     # optional: your own domain e.g. media.pulsif.store
